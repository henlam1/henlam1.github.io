---
import '../styles/global.css';
import { profile } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = `${profile.name} · Software Engineer`, description = profile.tagline } =
  Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Link previews (LinkedIn, Slack, iMessage) need full URLs, so these are built from
// `site` in astro.config.mjs.
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${base}/og.png`, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="420" />
    <meta property="og:image:alt" content={`${profile.name}: ${profile.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:ital,wght@0,400..800;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
