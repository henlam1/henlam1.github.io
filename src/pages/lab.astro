---
// A scratch page for experimenting with ASCII rendering.
// Open http://localhost:4321/lab while `npm run dev` is running.
// It isn't linked from the site, but it will be published with it:
// delete this file before going live, or keep it as a "lab" page on purpose.
import Base from '../layouts/Base.astro';
---

<Base title="ASCII lab">
  <main class="lab">
    <h1>ASCII lab</h1>
    <p class="lab__hint">
      Edit <code>src/lib/index.ts</code> and save. This page reloads with your changes.
    </p>

    <label class="lab__pick">
      Try your own image:
      <input type="file" accept="image/*" data-file />
    </label>
    <label class="lab__pick">
      Piece
      <select data-piece></select>
    </label>

    <div class="lab__panes">
      <figure>
        <figcaption>Original</figcaption>
        <canvas data-source></canvas>
      </figure>
      <figure>
        <figcaption>Your ASCII</figcaption>
        <canvas data-output></canvas>
      </figure>
    </div>
  </main>
</Base>

<script>
  import { toAscii } from '../lib/index.ts';
  import { getFont, getBaselineOffset } from '../lib/characters.ts';
  import { art } from '../data/site';

  const COLS = 80; // characters per row; try changing this
  const MAX_WIDTH = 800; // big photos are scaled down so there are fewer pixels to read

  const canvas = document.querySelector<HTMLCanvasElement>('[data-source]')!;
  const ctx = canvas.getContext('2d', { willReadFrequently: true })!;
  const output = document.querySelector<HTMLCanvasElement>('[data-output]')!;
  const outputCtx = output.getContext('2d')!;
  const fileInput = document.querySelector<HTMLInputElement>('[data-file]')!;
  const pieceSelect = document.querySelector<HTMLSelectElement>('[data-piece]')!;
  let frameId = 0;

  function drawAscii(lines: string[], width: number, height: number) {
    // Same size as the original. Setting these also clears the canvas and
    // resets its settings, so they have to come before the font.
    output.width = width;
    output.height = height;

    const cellWidth = width / COLS;
    const cellHeight = height / lines.length;

    outputCtx.font = getFont(cellWidth);
    outputCtx.textBaseline = 'alphabetic';
    outputCtx.fillStyle = '#f2f2f2';
    const baselineOffset = getBaselineOffset(outputCtx, cellHeight);

    lines.forEach((line, row) => {
      for (let col = 0; col < line.length; col++) {
        outputCtx.fillText(line[col], col * cellWidth, row * cellHeight + baselineOffset);
      }
    });
  }

  function showAscii(rows: number, invert: boolean) {
    // 6. Read every pixel back.
    const image = ctx.getImageData(0, 0, canvas.width, canvas.height);

    // 7. Convert image to Ascii and draw on the output canvas
    const lines = toAscii(image, COLS, rows, invert);
    drawAscii(lines, canvas.width, canvas.height);
  }

  function render(img: HTMLImageElement, frames: number, fps: number, invert: boolean) {
    // 0. Cancel the previous frame's animation
    cancelAnimationFrame(frameId); // stop the previous image's loop

    // 1. Setup canvas size and rows
    const frameWidth = img.naturalWidth / frames;
    const frameHeight = img.naturalHeight;
    const scale = MAX_WIDTH / frameWidth;
    canvas.width = Math.round(frameWidth * scale);
    canvas.height = Math.round(frameHeight * scale);

    // 2. Characters are about twice as tall as they are wide, so the picture
    //    needs about half as many rows as columns to keep its shape.
    const rows = Math.round(COLS * (canvas.height / canvas.width) * 0.5);

    let lastIndex = -1; // Track the last frame index so we don't constantly redraw
    function frame(time: number) {
      // 4. Call the next frame in the animation
      frameId = requestAnimationFrame(frame);

      // 5. Draw the current image on the canvas
      const index = Math.floor(time / (1000 / fps)) % frames;
      if (index === lastIndex) return; // same picture as last time: nothing to redo
      lastIndex = index;
      // Fill with the background colour first, so transparent areas read as empty (0):
      // white paper when inverted, black otherwise.
      ctx.fillStyle = invert ? '#fff' : '#000';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.imageSmoothingEnabled = false;
      ctx.drawImage(
        img,
        index * frameWidth,
        0,
        frameWidth,
        frameHeight,
        0,
        0,
        canvas.width,
        canvas.height,
      );

      showAscii(rows, invert);
    }

    // 3. Start the animation
    frameId = requestAnimationFrame(frame);
  }

  function load(src: string, frames = 1, fps = 1, invert = false) {
    const img = new Image();
    img.onload = () => render(img, frames, fps, invert);
    img.src = src;
  }

  fileInput.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    if (file) load(URL.createObjectURL(file));
  });

  // The site's base path (e.g. '' or '/portfolio'), without a trailing slash.
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');

  // Load one piece from the art list. Still images have no frames/fps, and most
  // pieces have no invert, so load()'s defaults (1 frame, 1 fps, not inverted) apply.
  function loadPiece(piece: (typeof art)[number]) {
    load(base + piece.src, piece.frames, piece.fps, piece.invert);
  }

  // One dropdown option per piece. The value is the piece's position in the
  // list, so the change handler can find it again.
  art.forEach((piece, i) => {
    pieceSelect.add(new Option(piece.title, String(i)));
  });

  // Load whichever piece is picked.
  pieceSelect.addEventListener('change', () => {
    loadPiece(art[Number(pieceSelect.value)]);
  });

  // Start with the first piece in the list.
  loadPiece(art[0]);
</script>

<style>
  .lab {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem var(--gutter) 4rem;
  }
  .lab h1 {
    font-size: var(--step-3);
  }
  .lab__hint {
    color: var(--paper-muted);
  }
  .lab__pick {
    display: block;
    margin: 1rem 0 2rem;
    font-size: var(--step-0);
  }
  .lab__panes {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }
  figure {
    margin: 0;
  }
  figcaption {
    margin-bottom: 0.5rem;
    color: var(--paper-muted);
    font-size: var(--step-0);
  }
  canvas {
    display: block;
    max-width: 100%;
    height: auto;
  }
</style>
