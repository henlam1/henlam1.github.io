---
// A framed viewer for your featured art. Each piece can be shown two ways:
// the original, or re-drawn as text characters. The frame is a fixed square,
// and the controls sit inside it.
//
// The ASCII mode uses your renderer from src/lib (toAscii): the same shape
// matching and contrast enhancement as the lab page.
import { art } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pieces = art
  .filter((p) => p.featured)
  .map((p) => ({
    title: p.title,
    caption: p.caption ?? '',
    src: `${base}${p.src}`,
    invert: p.invert ?? false,
  }));
const first = pieces[0];
---

{first && (
  <figure class="viewer" data-viewer data-pieces={JSON.stringify(pieces)}>
    <div class="viewer__frame">
      <canvas role="img" aria-label={`${first.title}, shown as text characters`} />

      {pieces.length > 1 && (
        <>
          <button
            type="button"
            class="viewer__step viewer__step--prev"
            data-step="-1"
            aria-label="Previous piece"
          >
            ‹
          </button>
          <button
            type="button"
            class="viewer__step viewer__step--next"
            data-step="1"
            aria-label="Next piece"
          >
            ›
          </button>
        </>
      )}

      <div class="viewer__modes" role="group" aria-label="Show this piece as">
        <button type="button" data-mode="original" aria-pressed="false">
          Original
        </button>
        <button type="button" data-mode="ascii" aria-pressed="true">
          ASCII
        </button>
      </div>
    </div>

    <figcaption class="viewer__caption">
      <span data-title>{first.title}</span>
      <span class="viewer__muted" data-caption>
        {first.caption}
      </span>
    </figcaption>
  </figure>
)}

<script>
  import { toAscii, CHARS } from '../lib/index.ts';
  import { getFont, getBaselineOffset } from '../lib/characters.ts';

  type Mode = 'original' | 'ascii';
  type Piece = { title: string; caption: string; src: string; invert: boolean };

  const ASCII_COLS = 64; // characters per row
  const REVEAL_MS = 700; // latest a character starts settling
  const SETTLE_MS = 350; // how long one character takes to settle
  const FADE_MS = 300;
  const MODE_LABEL = {
    original: 'shown as the original',
    ascii: 'shown as text characters',
  };

  // Turns a number into a fixed, random-looking value from 0 to 1. The same
  // input always gives the same output, so each cell keeps its own delay.
  function hash(i: number, seed = 0) {
    let h = Math.imul(i ^ seed, 2654435761);
    h ^= h >>> 15;
    h = Math.imul(h, 2246822519);
    h ^= h >>> 13;
    return (h >>> 0) / 4294967296;
  }

  const root = document.querySelector<HTMLElement>('[data-viewer]');
  if (root) init(root);

  function init(root: HTMLElement) {
    const canvas = root.querySelector('canvas')!;
    const ctx = canvas.getContext('2d')!;
    const sample = document.createElement('canvas');
    const sctx = sample.getContext('2d', { willReadFrequently: true })!;
    const pieces: Piece[] = JSON.parse(root.dataset.pieces!);
    const titleEl = root.querySelector('[data-title]')!;
    const captionEl = root.querySelector('[data-caption]')!;
    const modeButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-mode]')];
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const images = new Map<string, HTMLImageElement>();

    let mode: Mode = 'ascii';
    let index = 0;
    let img: HTMLImageElement | null = null;
    let width = 0; // canvas size in CSS pixels
    let height = 0;
    let dpr = 1;
    let changedAt = -Infinity;
    let frame = 0;
    // The piece converted to text. Converting is the slow part, so it's done once
    // per piece and size, not every animation frame. null means "convert again".
    let lines: string[] | null = null;

    modeButtons.forEach((b) =>
      b.addEventListener('click', () => {
        mode = b.dataset.mode as Mode;
        modeButtons.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
        restart();
      }),
    );
    root
      .querySelectorAll<HTMLButtonElement>('[data-step]')
      .forEach((b) =>
        b.addEventListener('click', () =>
          show((index + Number(b.dataset.step) + pieces.length) % pieces.length),
        ),
      );
    new ResizeObserver(resize).observe(canvas);
    show(0);

    function show(i: number) {
      index = i;
      const piece = pieces[i];
      titleEl.textContent = piece.title;
      captionEl.textContent = piece.caption;
      let im = images.get(piece.src);
      if (!im) {
        im = new Image();
        im.src = piece.src;
        images.set(piece.src, im);
      }
      if (im.complete && im.naturalWidth) {
        use(im);
      } else {
        im.onload = () => {
          if (pieces[index].src !== piece.src) return;
          use(im!);
        };
      }
    }

    // Switch to a newly loaded piece. The frame keeps its size; the piece is
    // fitted inside it.
    function use(im: HTMLImageElement) {
      img = im;
      lines = null;
      restart();
    }

    function restart() {
      canvas.setAttribute('aria-label', `${pieces[index].title}, ${MODE_LABEL[mode]}`);
      changedAt = reduceMotion ? -Infinity : performance.now();
      request();
    }

    function resize() {
      width = canvas.clientWidth;
      height = canvas.clientHeight;
      dpr = Math.min(devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      lines = null;
      request();
    }

    function request() {
      if (!frame) frame = requestAnimationFrame(draw);
    }

    // Where to draw the image inside a w × h box so it fits without cropping.
    function fit(w: number, h: number, sx = 1, sy = 1) {
      const s = Math.min(w / (img!.naturalWidth / sx), h / (img!.naturalHeight / sy));
      const dw = (img!.naturalWidth / sx) * s;
      const dh = (img!.naturalHeight / sy) * s;
      return [(w - dw) / 2, (h - dh) / 2, dw, dh] as const;
    }

    // Run the piece through your renderer. The sample canvas is the frame's size
    // in CSS pixels, so each character cell is the size it's drawn at. It's filled
    // with the piece's background first (white paper when inverted, black otherwise),
    // so transparent areas and the space around the piece read as empty.
    function convert() {
      const invert = pieces[index].invert;
      const rows = Math.round(ASCII_COLS * (height / width) * 0.5);
      sample.width = Math.round(width);
      sample.height = Math.round(height);
      sctx.fillStyle = invert ? '#fff' : '#000';
      sctx.fillRect(0, 0, sample.width, sample.height);
      sctx.drawImage(img!, ...fit(sample.width, sample.height));
      const image = sctx.getImageData(0, 0, sample.width, sample.height);
      return toAscii(image, ASCII_COLS, rows, invert);
    }

    function draw(now: number) {
      frame = 0;
      if (!img || !width || !height) return;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, width, height);
      const t = now - changedAt;
      let animating = false;

      if (mode === 'original') {
        const p = Math.min(1, t / FADE_MS);
        ctx.globalAlpha = p;
        ctx.drawImage(img, ...fit(width, height));
        ctx.globalAlpha = 1;
        animating = p < 1;
      } else {
        if (!lines) lines = convert();
        const cw = width / ASCII_COLS;
        const ch = height / lines.length;
        const tick = Math.floor(now / 120);
        ctx.font = getFont(cw);
        ctx.textBaseline = 'alphabetic';
        ctx.fillStyle = '#f2f2f2';
        const baseline = getBaselineOffset(ctx, ch);
        for (let r = 0; r < lines.length; r++) {
          for (let c = 0; c < ASCII_COLS; c++) {
            let char = lines[r][c];
            if (char === ' ') continue;
            const i = r * ASCII_COLS + c;
            // Scramble, then settle into place: each cell starts at its own
            // time, shows random characters that change every 120 ms while
            // fading in, then shows its real character.
            const p = (t - hash(i, 7) * REVEAL_MS) / SETTLE_MS;
            if (p < 1) {
              char = CHARS[1 + Math.floor(hash(i, tick) * (CHARS.length - 1))]; // never a space
              ctx.globalAlpha = Math.max(0.25, p);
              animating = true;
            } else {
              ctx.globalAlpha = 1;
            }
            ctx.fillText(char, c * cw, r * ch + baseline);
          }
        }
        ctx.globalAlpha = 1;
      }

      if (animating) request();
    }
  }
</script>

<style>
  .viewer {
    margin: 0;
    width: 100%;
    max-width: 480px;
    justify-self: end;
  }

  .viewer__frame {
    position: relative;
    /* One fixed shape for every piece, so the page doesn't move when you switch.
       Each piece is fitted inside without cropping; the spare space stays black. */
    aspect-ratio: 1;
    border: 1px solid #3a3a3a;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .viewer__frame canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Controls float over the art on a dark backing, so they stay readable on
     both black ASCII and white originals. */
  .viewer__modes {
    position: absolute;
    left: 50%;
    bottom: 12px;
    translate: -50% 0;
    display: inline-flex;
    padding: 3px;
    border: 1px solid #3a3a3a;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.78);
  }

  .viewer button {
    border: 0;
    background: none;
    color: var(--paper-muted);
    font: inherit;
    font-size: var(--step-0);
    cursor: pointer;
  }

  .viewer__modes button {
    min-height: 38px;
    padding: 0 0.95rem;
    border-radius: 999px;
  }

  .viewer button:hover {
    color: var(--paper);
  }

  .viewer__modes button[aria-pressed='true'] {
    background: var(--paper);
    color: var(--ink);
  }

  /* .viewer .viewer__step outranks the general .viewer button rule above. */
  .viewer .viewer__step {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0 0 3px;
    border: 1px solid #3a3a3a;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.78);
    font-size: var(--step-3);
    line-height: 1;
  }
  .viewer__step--prev {
    left: 10px;
  }
  .viewer__step--next {
    right: 10px;
  }

  .viewer__caption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin-top: 0.75rem;
    font-size: var(--step-0);
  }

  .viewer__muted {
    color: var(--paper-muted);
  }
</style>
